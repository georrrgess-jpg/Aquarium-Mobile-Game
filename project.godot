; Engine configuration file.
config_version=5

[application]

config/name="Tidepool Tycoon"
config/description="Portrait merge puzzle: waves crowd a tidal pool, and the creatures you make become permanent residents of your reef."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.0392157, 0.168627, 0.25098, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
